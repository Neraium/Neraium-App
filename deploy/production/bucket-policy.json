{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppCloudFrontOnly",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::neraium-app-prod-frontend-680779862188/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::680779862188:distribution/E27KJ5Y66YQQBO"
        }
      }
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::neraium-app-prod-frontend-680779862188",
        "arn:aws:s3:::neraium-app-prod-frontend-680779862188/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
