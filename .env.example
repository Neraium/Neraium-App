# Export these in the launch shell. No .env file is loaded automatically.
NERAIUM_WORKBENCH_TOKEN=
# Must be outside this repository. Default: ~/.local/share/neraium-workbench
NERAIUM_WORKBENCH_DATA=
# Separate clean, pinned Neraium-1.0 checkout and its installed interpreter.
NERAIUM_AUTHORITY_ROOT=
# Optional assertion; blank uses SUPPORTED_COMMIT in backend/workbench/authority.py.
NERAIUM_AUTHORITY_COMMIT=
NERAIUM_AUTHORITY_PYTHON=
